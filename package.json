{
  "name": "vdai-os",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.5.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "keywords": ["vdai", "twenty", "crm", "project-os"],
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilevdasfo/vdai-os.git"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "typecheck": "tsgo --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "verify:public": "node scripts/verify-public.mjs",
    "bridge:convert": "node scripts/problemos-bridge.mjs",
    "export:portable": "node scripts/export-portable.mjs",
    "import:portable": "node scripts/import-portable.mjs",
    "version:report": "node scripts/version-report.mjs",
    "security:rls": "node scripts/configure-project-rls.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:build": "bash scripts/build-release.sh",
    "site:verify": "node scripts/verify-onboarding-site.mjs",
    "site:build": "bash scripts/build-site.sh",
    "site:deploy": "bash scripts/deploy-site.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.35.1",
    "twenty-sdk": "2.35.1",
    "twenty-ui": "1.0.0-alpha.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
}
